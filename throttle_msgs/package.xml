<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>throttle_msgs</name>
  <version>0.0.0</version>
  <description>Custom throttle / mode / gear message</description>

  <!-- ⓘ maintainer·license 는 나중에 실제 정보로 교체하세요 -->
  <maintainer email="shinjuyeop@example.com">Shin Juyeop</maintainer>
  <license>Apache-2.0</license>

  <!-- ── build tools ───────────────────────────── -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>  <!-- 추가 -->

  <!-- ── runtime deps ──────────────────────────── -->
  <depend>std_msgs</depend>

  <!-- ── test ──────────────────────────────────── -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- 메시지 패키지라는 표시 -->
  <member_of_group>rosidl_interface_packages</member_of_group>    <!-- 추가 -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
