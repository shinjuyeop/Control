#!/usr/bin/env python3
"""Compare recorded steering trials using the calibrated encoder response."""
import argparse,json
from pathlib import Path
import numpy as np
import rosbag2_py
from rclpy.serialization import deserialize_message
from diagnostic_msgs.msg import DiagnosticArray
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
from lateral_data import read_run, timing

def main():
    p=argparse.ArgumentParser(description=__doc__);p.add_argument('--pd');p.add_argument('--mpc')
    p.add_argument('--calibration',required=True);p.add_argument('--output',required=True);a=p.parse_args()
    out=Path(a.output);out.mkdir(parents=True,exist_ok=True);fig,axs=plt.subplots(3,1,figsize=(10,8),sharex=True);report={}
    for label,path,color in [('PD',a.pd,'#1f77b4'),('MPC',a.mpc,'#d95f02')]:
        if not path:continue
        r=read_run(path,a.calibration);mask=r['valid'] & (r.get('speed',np.zeros(len(r['t'])))>.2)
        if not mask.any():raise ValueError(f'{label}: no moving ACTIVE samples')
        start=np.flatnonzero(mask)[0];t=r['t']-r['t'][start]
        error=np.rad2deg(r['angle'][mask]-r['reference'][mask])
        report[label]=dict(rmse_deg=float(np.sqrt(np.mean(error**2))),p95_abs_error_deg=float(np.quantile(np.abs(error),.95)),
                          max_abs_error_deg=float(np.max(np.abs(error))),timing=timing(path),bag=str(Path(path).resolve()))
        axs[0].plot(t[mask],np.rad2deg(r['angle'][mask]),label=label,color=color)
        axs[1].plot(t[mask],error,label=label,color=color)
        if 'u' in r:axs[2].plot(t[mask],r['u'][mask]*10000,label=label,color=color)
        if label=='MPC':axs[0].plot(t[mask],np.rad2deg(r['reference'][mask]),'k--',label='Target')
    for ax,title in zip(axs,['Steering [deg]','Tracking error [deg]','KEYA torque command [raw]']):ax.set_ylabel(title);ax.grid(alpha=.25);ax.legend()
    axs[-1].set_xlabel('Time from moving ACTIVE [s]');fig.tight_layout();fig.savefig(out/'steering_comparison.png',dpi=170);fig.savefig(out/'steering_comparison.svg')
    (out/'metrics.json').write_text(json.dumps(report,indent=2));print(json.dumps(report,indent=2))
if __name__=='__main__':main()
