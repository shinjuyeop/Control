    "Tab!ctrl_detail": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "Power",
          "layout": {
            "first": "Plot!ctrl_current",
            "second": {
              "first": "Plot!ctrl_voltage",
              "second": "Plot!ctrl_temp",
              "direction": "row",
              "splitPercentage": 50
            },
            "direction": "column",
            "splitPercentage": 50
          }
        },
        {
          "title": "State",
          "layout": {
            "first": {
              "first": "StateTransitions!ctrl_drive",
              "second": "StateTransitions!ctrl_steer_state",
              "direction": "row",
              "splitPercentage": 50
            },
            "second": {
              "first": "Indicator!ctrl_steer_state_now",
              "second": "Indicator!ctrl_steer_reason_now",
              "direction": "row",
              "splitPercentage": 50
            },
            "direction": "column",
            "splitPercentage": 72
          }
        },
        {
          "title": "Fault",
          "layout": {
            "first": {
              "first": "RawMessages!ctrl_fault",
              "second": "RawMessages!ctrl_steer_fault",
              "direction": "row",
              "splitPercentage": 50
            },
            "second": {
              "first": "RawMessages!ctrl_now",
              "second": {
                "first": "RawMessages!ctrl_steer_now",
                "second": "RawMessages!ctrl_brake_now",
                "direction": "row",
                "splitPercentage": 50
              },
              "direction": "row",
              "splitPercentage": 33.34
            },
            "direction": "column",
            "splitPercentage": 38
          }
        }
      ]
    },
