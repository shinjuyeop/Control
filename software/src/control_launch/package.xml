<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>control_launch</name>
  <version>0.0.0</version>
  <description>Control vehicle launch files and joystick command publisher.</description>
  <maintainer email="shinjp02@gmail.com">shinjuyeop</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>kaiev26_msgs</depend>
  <exec_depend>joy</exec_depend>

  <!-- vehicle.launch.py가 띄우는 패키지들 -->
  <exec_depend>micro_ros_agent</exec_depend>
  <exec_depend>command_governor</exec_depend>
  <exec_depend>lateral_ctrl</exec_depend>
  <exec_depend>vehicle_state_publisher</exec_depend>
  <exec_depend>kaiev26_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>control_tuning</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
  <exec_depend>longitudinal_mpc</exec_depend>
</package>
