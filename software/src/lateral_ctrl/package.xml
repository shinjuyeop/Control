<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lateral_ctrl</name>
  <version>0.1.0</version>
  <description>Safety-oriented KEYA steering actuator control for TeamKAI-DL.</description>
  <maintainer email="shinjp02@gmail.com">shinjuyeop</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>kaiev26_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ebimu_driver</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>control_tuning</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
