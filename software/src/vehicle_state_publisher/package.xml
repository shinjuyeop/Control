<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_state_publisher</name>
  <version>0.1.0</version>
  <description>
    서브시스템 status 3종(/steering/status, /drive/status, /brake/status)을
    합성해 통합 차량 상태 /vehicle/state, kinematic /vehicle/wheel_twist 와
    관측용 /diagnostics 를 발행한다. legacy 토픽 미사용.
  </description>
  <maintainer email="kai.driverless@gmail.com">kangmin</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>kaiev26_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>um980_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
